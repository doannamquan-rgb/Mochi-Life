{
  "name": "mobile",
  "version": "6.1.1",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "doctor": "npx expo-doctor",
    "update:preview": "eas update --channel preview",
    "update:production": "eas update --channel production",
    "build:preview": "eas build -p android --profile preview",
    "build:production": "eas build -p android --profile production",
    "eas-build-pre-install": "npm install --package-lock-only"
  },
  "expo": {
    "install": {
      "exclude": [
        "react",
        "react-dom",
        "react-native-svg"
      ]
    }
  },
  "dependencies": {
    "@mochi/shared": "*",
    "@react-native-async-storage/async-storage": "^2.1.2",
    "@supabase/supabase-js": "^2.110.8",
    "@tanstack/react-query": "^5.101.4",
    "date-fns": "^4.4.0",
    "expo": "~57.0.13",
    "expo-constants": "~57.0.11",
    "expo-font": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-image": "~57.0.3",
    "expo-linking": "~57.0.6",
    "expo-router": "~57.0.13",
    "expo-splash-screen": "~57.0.6",
    "expo-status-bar": "~57.0.1",
    "expo-updates": "~57.0.14",
    "lucide-react-native": "^1.27.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-native": "0.86.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.5",
    "react-native-url-polyfill": "^2.0.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "eas-cli": "^22.0.0",
    "typescript": "~6.0.3"
  },
  "private": true
}
