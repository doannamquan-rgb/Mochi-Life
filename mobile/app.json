{
  "expo": {
    "name": "Mochi Life",
    "slug": "mochi-life",
    "version": "6.3.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "mochilife",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mochilife.app"
    },
    "android": {
      "package": "com.mochilife.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#FFF8F0",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-image",
      [
        "expo-splash-screen",
        {
          "image": "./assets/icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FFF8F0"
        }
      ]
    ],
    "updates": {
      "url": "https://u.expo.dev/e437fc67-2322-41a3-a62d-cc8fffc11aa2"
    },
    "runtimeVersion": "6.1.0",
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "e437fc67-2322-41a3-a62d-cc8fffc11aa2"
      }
    }
  }
}
